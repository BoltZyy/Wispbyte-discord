# Salin menjadi .env (lokal), atau isi sebagai environment variable di Wispbyte.
# JANGAN commit file .env yang berisi nilai asli.
# Setiap nama punya alias lama (legacy) yang masih dibaca; kalau keduanya diisi,
# nama baru (huruf besar) yang dipakai.

# --- Wajib ---
# Alias lama: Discord_token
DISCORD_TOKEN=

# --- Provider AI (isi minimal satu; yang kosong dilewati) ---
# Alias lama: Gemini_API
GEMINI_KEY_1=
# Alias lama: Gemini_API_2
GEMINI_KEY_2=
# Alias lama: Groq_API
GROQ_KEY=
# Alias lama: Openrouter_API
OPENROUTER_KEY=
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=

# --- Opsional ---
# Prefix perintah teks (default: !tanya)
# COMMAND_PREFIX=!tanya
# Persona bot. Urutan: SYSTEM_PROMPT, lalu Personality, lalu persona bawaan.
# SYSTEM_PROMPT=
# Personality=
# ID Discord owner (default: ID bawaan di src/core/owner.js)
# OWNER_ID=
# Jumlah giliran riwayat percakapan per channel dan user (default: 6)
# MAX_HISTORY=6
# Batas waktu fallback AI dalam milidetik (default: 20000 per percobaan, 60000 total)
# AI_ATTEMPT_TIMEOUT_MS=20000
# AI_TOTAL_TIMEOUT_MS=60000
# Lokasi database SQLite, relatif terhadap root proyek (default: data/ovelia.sqlite)
# DB_PATH=data/ovelia.sqlite
